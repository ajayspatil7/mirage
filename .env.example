# Mirage ML Engine Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
HOST=0.0.0.0
PORT=8001
WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100
CLEANUP_AFTER_HOURS=24

# Model Configuration
DEFAULT_MODEL=ctgan
MODEL_CACHE_SIZE=3
MAX_CONCURRENT_JOBS=5

# Hardware Optimization (M4 Pro)
USE_MPS=true
MPS_FALLBACK=true
TORCH_THREADS=8

# Development
RELOAD=true
API_PREFIX=/api/v1
